// Update server configuration. Restart the server after changing it.
// Any value can also be set with an environment variable, e.g. FileUpdater__Server__Port=9000
{
  "FileUpdater": {
    "Server": {
      // Port to listen on
      "Port": 8080,
      // Address to bind to: empty for all interfaces, "127.0.0.1" for this machine only, "::" for all IPv6
      "Hostname": "",
      // Downloads served at once, 0 for unlimited (not recommended)
      "MaxConcurrentDownloads": 50
    },

    "Files": {
      // Folder with the files players download, relative to the server or absolute. Created if missing
      "FilesDirectory": "./files/",
      // Folder with the signed launcher and TazUO packages (the PackageSigner tool's output). Created if missing
      "PackagesDirectory": "./packages/",
      // Rebuild the file list shortly after files are added, changed or removed
      "WatchFilesDirectory": true,
      // Seconds a file must go unmodified before it is listed, so half-copied files are never served
      "FileSettleTime": 5,
      // Full rebuild interval in seconds, as a fallback to watching. 0 turns it off
      "CacheRegenerationInterval": 3600
    },

    "Security": {
      // CORS origins separated by semicolons, or * for any
      "CorsAllowedOrigins": "*",
      // Refuse paths with ".." segments or absolute paths up front (paths outside the folder are refused either way)
      "EnablePathTraversalProtection": true,
      // Largest file served, in bytes. 0 for no limit
      "MaxFileSize": 0
    },

    "Log": {
      // Trace, Debug, Information, Warning, Error or Critical
      "LogLevel": "Information",
      // Also write logs to this file, relative to the server. Empty for console only
      "LogFilePath": "",
      // One log line per request
      "EnableRequestLogging": true
    },

    "Performance": {
      // gzip/brotli compression of the file list
      "EnableCompression": true
    }
  }

  // To serve https directly, add a "Kestrel" section next to "FileUpdater". Port and Hostname are then ignored:
  // "Kestrel": { "Endpoints": { "Https": { "Url": "https://*:443",
  //     "Certificate": { "Path": "cert.pfx", "Password": "..." } } } }
}
