<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests build this project framework-dependent; without this the library would be built a second time
         with their settings, racing the first build for the same output files -->
    <ProjectReference Include="../PackageManifest/PackageManifest.csproj" GlobalPropertiesToRemove="SelfContained;RuntimeIdentifier;PublishSingleFile" />
  </ItemGroup>

</Project>
