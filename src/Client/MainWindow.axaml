<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FileUpdaterClient.MainWindow"
             RequestedThemeVariant="Dark">
    <!-- Shared by the main window and its dialogs -->
    <Application.Resources>
        <FontFamily x:Key="DisplayFont">Cinzel, Trajan Pro, Georgia, Times New Roman, serif</FontFamily>

        <LinearGradientBrush x:Key="GoldBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FFF6D9" />
            <GradientStop Offset="0.45" Color="#D9A953" />
            <GradientStop Offset="0.55" Color="#9C6B2A" />
            <GradientStop Offset="1" Color="#E8C379" />
        </LinearGradientBrush>

        <!-- Laid over each progress bar so any configured color gets the same glossy look -->
        <LinearGradientBrush x:Key="BarGlossBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#70FFFFFF" />
            <GradientStop Offset="0.45" Color="#10FFFFFF" />
            <GradientStop Offset="0.55" Color="#00000000" />
            <GradientStop Offset="1" Color="#60000000" />
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- Settings / minimize / close / cancel squares -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="#E8D6B0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="#6B5431" BorderThickness="2"
                            CornerRadius="2" BoxShadow="inset 0 0 8 0 #80000000">
                        <ContentPresenter Name="Glyph" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.chrome.minimize">
            <Setter Property="Background" Value="#3E3A24" />
        </Style>
        <Style Selector="Button.chrome.minimize:pointerover">
            <Setter Property="Background" Value="#5C5634" />
        </Style>
        <Style Selector="Button.chrome.close">
            <Setter Property="Background" Value="#5A1717" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover">
            <Setter Property="Background" Value="#8A2020" />
        </Style>
        <Style Selector="Button.chrome.settings">
            <Setter Property="Background" Value="#1E2A44" />
        </Style>
        <Style Selector="Button.chrome.settings:pointerover">
            <Setter Property="Background" Value="#2E3F63" />
        </Style>

        <!-- Buttons along the bottom of dialogs -->
        <Style Selector="Button.dialog">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Foreground" Value="#F2E6CC" />
            <Setter Property="Background" Value="#3A120D" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="Label" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dialog:pointerover">
            <Setter Property="Background" Value="#6A2216" />
        </Style>
        <Style Selector="Button.dialog.secondary">
            <Setter Property="Background" Value="#241C16" />
        </Style>
        <Style Selector="Button.dialog.secondary:pointerover">
            <Setter Property="Background" Value="#3A2E22" />
        </Style>
    </Application.Styles>
</Application>
