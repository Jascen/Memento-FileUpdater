<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="675"
        Width="900" Height="675" CanResize="False"
        SystemDecorations="None" WindowStartupLocation="CenterScreen"
        xmlns:vm="using:FileUpdaterClient" Background="#141110"
        x:Class="FileUpdaterClient.Main" x:DataType="vm:MainViewModel"
        PointerPressed="Window_PointerPressed">

    <Window.Resources>
        <FontFamily x:Key="DisplayFont">Cinzel, Trajan Pro, Georgia, Times New Roman, serif</FontFamily>

        <LinearGradientBrush x:Key="GoldBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FFF6D9" />
            <GradientStop Offset="0.45" Color="#D9A953" />
            <GradientStop Offset="0.55" Color="#9C6B2A" />
            <GradientStop Offset="1" Color="#E8C379" />
        </LinearGradientBrush>

        <!-- Laid over each progress bar so any configured color gets the same glossy look -->
        <LinearGradientBrush x:Key="BarGlossBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#70FFFFFF" />
            <GradientStop Offset="0.45" Color="#10FFFFFF" />
            <GradientStop Offset="0.55" Color="#00000000" />
            <GradientStop Offset="1" Color="#60000000" />
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <!-- Top navigation links: brighten and grow a gold underline from the center on hover -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E3CF9E" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Background="{TemplateBinding Background}" Margin="{TemplateBinding Padding}" Spacing="4">
                        <ContentPresenter Name="Label" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                        <Border Name="Underline" Height="2" CornerRadius="1" Background="{StaticResource GoldBrush}"
                                RenderTransform="scaleX(0)">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Foreground" Value="#FFF4D2" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ Border#Underline">
            <Setter Property="RenderTransform" Value="scaleX(1)" />
        </Style>

        <!-- Minimize / close / cancel squares -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="#E8D6B0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="#6B5431" BorderThickness="2"
                            CornerRadius="2" BoxShadow="inset 0 0 8 0 #80000000">
                        <ContentPresenter Name="Glyph" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.chrome.minimize">
            <Setter Property="Background" Value="#3E3A24" />
        </Style>
        <Style Selector="Button.chrome.minimize:pointerover">
            <Setter Property="Background" Value="#5C5634" />
        </Style>
        <Style Selector="Button.chrome.close">
            <Setter Property="Background" Value="#5A1717" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover">
            <Setter Property="Background" Value="#8A2020" />
        </Style>

        <!-- Play button: framed hexagon that glows and grows slightly on hover -->
        <Style Selector="Button.play">
            <Setter Property="Foreground" Value="#F2E6CC" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="270" Height="96">
                        <Path Name="Glow" Stretch="Fill" Margin="-6" Opacity="0"
                              Data="M 30,0 L 240,0 L 270,48 L 240,96 L 30,96 L 0,48 Z" Fill="#FF7A1F">
                            <Path.Effect>
                                <BlurEffect Radius="18" />
                            </Path.Effect>
                            <Path.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                                </Transitions>
                            </Path.Transitions>
                        </Path>
                        <Path Stretch="Fill" StrokeThickness="6" Stroke="{StaticResource GoldBrush}"
                              Data="M 30,0 L 240,0 L 270,48 L 240,96 L 30,96 L 0,48 Z">
                            <Path.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#7A2418" />
                                    <GradientStop Offset="0.7" Color="#3A120D" />
                                    <GradientStop Offset="1" Color="#1C0907" />
                                </RadialGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path Stretch="Fill" Margin="11" StrokeThickness="1.5" Stroke="#8C6630"
                              Data="M 30,0 L 240,0 L 270,48 L 240,96 L 30,96 L 0,48 Z" />
                        <ContentPresenter Name="Label" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="6" OffsetX="0" OffsetY="2" Opacity="0.9" />
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.play:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>
        <Style Selector="Button.play:pointerover /template/ Path#Glow">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button.play:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>
        <Style Selector="Button.play:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="ProgressBar.bar">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{x:Static vm:Settings.ProgressBarBackground}" />
        </Style>
        <Style Selector="TextBlock.barText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{x:Static vm:Settings.DefaultTextColor}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="3" OffsetX="0" OffsetY="1" Opacity="1" />
            </Setter>
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Foreground" Value="#CDBB92" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="Label" Background="Transparent" Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Foreground" Value="#FFF4D2" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Art -->
        <Image Source="avares://FileUpdaterClient/resources/background.png" Stretch="UniformToFill" />

        <!-- Darken the edges and the top/bottom bands so text and controls stay readable over any art -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush RadiusX="75%" RadiusY="75%">
                    <GradientStop Offset="0.45" Color="#00000000" />
                    <GradientStop Offset="1" Color="#E0000000" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#D0000000" />
                    <GradientStop Offset="0.12" Color="#00000000" />
                    <GradientStop Offset="0.62" Color="#00000000" />
                    <GradientStop Offset="1" Color="#F0000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False" BorderBrush="#3A2E1F" BorderThickness="2" />

        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Top bar: links centered, window buttons on the right -->
            <Grid Grid.Row="0" Height="60">
                <ItemsControl ItemsSource="{Binding Links}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:NavLink">
                            <Button Classes="nav" Content="{Binding Label}" Click="NavLink_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0" Spacing="4">
                    <Button Classes="chrome minimize" Click="Minimize_Click" ToolTip.Tip="Minimize">
                        <Border Width="14" Height="3" Background="#E8D6B0" CornerRadius="1" />
                    </Button>
                    <Button Classes="chrome close" Click="Close_Click" ToolTip.Tip="Close">
                        <Path Data="M 0,0 L 14,14 M 14,0 L 0,14" Stroke="#E8D6B0" StrokeThickness="2.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Title and play button -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="92" FontWeight="Bold" LetterSpacing="4"
                           HorizontalAlignment="Center" Foreground="{Binding TitleColor}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF8A2A" BlurRadius="28" OffsetX="0" OffsetY="0" Opacity="0.85" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding Subtitle}" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                           HorizontalAlignment="Center" Foreground="{Binding SubtitleColor}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" OffsetX="0" OffsetY="1" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>
                <Button Classes="play" Content="{Binding PlayText}" IsEnabled="{Binding CanPlay}"
                        HorizontalAlignment="Center" Margin="0,28,0,0" Click="Play_Click" />
            </StackPanel>

            <!-- Progress: blue = all files, red = current file -->
            <Grid Grid.Row="2" Height="170">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" Width="520">
                        <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#FF6B5E" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" OffsetX="0" OffsetY="1" Opacity="1" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <Button Grid.Column="1" Classes="chrome close" Width="22" Height="22" Click="Cancel_Click"
                                IsVisible="{Binding IsUpdating}" ToolTip.Tip="Cancel update">
                            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="#E8D6B0" StrokeThickness="1.5" />
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Width="560">
                        <Path Grid.Column="0" Data="M 22,0 L 0,30 L 22,60 L 16,30 Z" Fill="{StaticResource GoldBrush}"
                              VerticalAlignment="Center" Margin="0,0,-2,0" />
                        <Border Grid.Column="1" Padding="4" CornerRadius="16" BorderThickness="3"
                                BorderBrush="{StaticResource GoldBrush}" Background="#E0120E0B"
                                BoxShadow="0 0 12 2 #A0000000">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <ProgressBar Classes="bar" Value="{Binding Progress}"
                                                 Foreground="{x:Static vm:Settings.TotalProgressColor}" />
                                    <Border CornerRadius="11" Background="{StaticResource BarGlossBrush}" IsHitTestVisible="False" />
                                    <TextBlock Classes="barText" Text="{Binding ProgressText}" />
                                </Grid>
                                <Grid>
                                    <ProgressBar Classes="bar" Value="{Binding FileProgress}"
                                                 Foreground="{x:Static vm:Settings.FileProgressColor}" />
                                    <Border CornerRadius="11" Background="{StaticResource BarGlossBrush}" IsHitTestVisible="False" />
                                    <TextBlock Classes="barText" Text="{Binding FileProgressText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Path Grid.Column="2" Data="M 0,0 L 22,30 L 0,60 L 6,30 Z" Fill="{StaticResource GoldBrush}"
                              VerticalAlignment="Center" Margin="-2,0,0,0" />
                    </Grid>
                </StackPanel>

                <Button Classes="link" Content="{Binding PrivacyPolicyText}" IsVisible="{Binding HasPrivacyPolicy}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,14"
                        Click="PrivacyPolicy_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
