<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FileUpdaterClient.App"
             RequestedThemeVariant="Dark">
    <!-- Colors, fonts and images come from Theme/theme.json as Theme.<name> resources (see Config/ThemeLoader.cs) -->
    <Application.Styles>
        <FluentTheme/>

        <!-- Settings / minimize / close / cancel squares -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.ChromeGlyph}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Theme.ChromeBorder}" BorderThickness="1.5"
                            CornerRadius="4" BoxShadow="0 0 10 0 #60000000, inset 0 0 10 0 #60000000">
                        <ContentPresenter Name="Glyph" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.chrome.minimize">
            <Setter Property="Background" Value="{DynamicResource Theme.ChromeMinimize}" />
        </Style>
        <Style Selector="Button.chrome.minimize:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.ChromeMinimizeHover}" />
        </Style>
        <Style Selector="Button.chrome.close">
            <Setter Property="Background" Value="{DynamicResource Theme.ChromeClose}" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.ChromeCloseHover}" />
        </Style>
        <Style Selector="Button.chrome.settings">
            <Setter Property="Background" Value="{DynamicResource Theme.ChromeSettings}" />
        </Style>
        <Style Selector="Button.chrome.settings:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.ChromeSettingsHover}" />
        </Style>

        <!-- Buttons along the bottom of dialogs -->
        <Style Selector="Button.dialog">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.DialogButtonText}" />
            <Setter Property="Background" Value="{DynamicResource Theme.DialogButton}" />
            <Setter Property="FontFamily" Value="{DynamicResource Theme.DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Theme.Frame}"
                            BorderThickness="2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="Label" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dialog:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.DialogButtonHover}" />
        </Style>
        <Style Selector="Button.dialog.secondary">
            <Setter Property="Background" Value="{DynamicResource Theme.DialogButtonSecondary}" />
        </Style>
        <Style Selector="Button.dialog.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.DialogButtonSecondaryHover}" />
        </Style>
    </Application.Styles>
</Application>
