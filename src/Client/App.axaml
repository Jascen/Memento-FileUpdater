<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FileUpdaterClient.App"
             RequestedThemeVariant="Dark">
    <!-- Shared by the main window and its dialogs -->
    <Application.Resources>
        <FontFamily x:Key="DisplayFont">Cinzel, Trajan Pro, Georgia, Times New Roman, serif</FontFamily>

        <LinearGradientBrush x:Key="FrameBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#D0C9DCD2" />
            <GradientStop Offset="0.45" Color="#C08DAFA2" />
            <GradientStop Offset="0.55" Color="#C0506F68" />
            <GradientStop Offset="1" Color="#D0A6C2B6" />
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- Settings / minimize / close / cancel squares -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="#E4ECE6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="#704A4270" BorderThickness="1.5"
                            CornerRadius="4" BoxShadow="0 0 10 0 #60000000, inset 0 0 10 0 #60000000">
                        <ContentPresenter Name="Glyph" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.chrome.minimize">
            <Setter Property="Background" Value="#B01E3A37" />
        </Style>
        <Style Selector="Button.chrome.minimize:pointerover">
            <Setter Property="Background" Value="#D02C5550" />
        </Style>
        <Style Selector="Button.chrome.close">
            <Setter Property="Background" Value="#B04A1830" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover">
            <Setter Property="Background" Value="#D07A2446" />
        </Style>
        <Style Selector="Button.chrome.settings">
            <Setter Property="Background" Value="#B02A2350" />
        </Style>
        <Style Selector="Button.chrome.settings:pointerover">
            <Setter Property="Background" Value="#D03D3372" />
        </Style>

        <!-- Buttons along the bottom of dialogs -->
        <Style Selector="Button.dialog">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Foreground" Value="#F4EDD6" />
            <Setter Property="Background" Value="#2E2452" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource FrameBrush}"
                            BorderThickness="2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="Label" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dialog:pointerover">
            <Setter Property="Background" Value="#45377A" />
        </Style>
        <Style Selector="Button.dialog.secondary">
            <Setter Property="Background" Value="#181426" />
        </Style>
        <Style Selector="Button.dialog.secondary:pointerover">
            <Setter Property="Background" Value="#2A2340" />
        </Style>
    </Application.Styles>
</Application>
