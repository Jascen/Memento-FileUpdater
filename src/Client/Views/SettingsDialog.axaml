<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileUpdaterClient.UserSettings"
        xmlns:config="using:FileUpdaterClient.Config"
        x:Class="FileUpdaterClient.Views.SettingsDialog" x:DataType="vm:Preferences"
        Title="Settings" Width="440" SizeToContent="Height" CanResize="False"
        SystemDecorations="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="Transparent" TransparencyLevelHint="Transparent">
    <Window.Resources>
        <!-- Teal check boxes instead of the theme's blue -->
        <Color x:Key="SystemAccentColor">#5FAE96</Color>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#5FAE96" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#82CCB4" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#467F6F" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#5FAE96" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#82CCB4" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#120E20" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#120E20" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#DCE6DE" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>

    <Border Background="#F0161228" BorderBrush="{StaticResource FrameBrush}" BorderThickness="3" CornerRadius="6"
            Padding="24,20">
        <StackPanel Spacing="14">
            <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                       Foreground="#F4EDD6" />

            <StackPanel Spacing="6">
                <TextBlock Text="Install Directory" FontSize="14" FontWeight="SemiBold" Foreground="#DCE6DE" />
                <Grid ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Background="#0C0A16" BorderBrush="#3E3662" BorderThickness="1"
                            CornerRadius="3" Padding="8,6" Margin="0,0,8,0">
                        <TextBlock Name="InstallPathText" FontSize="12" Foreground="#B4CCC2"
                                   TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="1" Name="ChangeFolderButton" Classes="dialog secondary" MinWidth="0"
                            Padding="14,6" FontSize="13" Click="ChangeFolder_Click" />
                </Grid>
                <TextBlock Name="FolderErrorText" FontSize="12" Foreground="#FF6B5E" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>

            <CheckBox Content="Attempt to verify files on launch" IsChecked="{Binding VerifyOnLaunch}" />
            <CheckBox Content="Warn when trying to play if verification fails" IsChecked="{Binding WarnIfNotVerified}"
                      IsVisible="{x:Static config:TazUOLauncherConfig.Enabled}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Content="Cancel" Classes="dialog secondary" Click="Cancel_Click" IsCancel="True" />
                <Button Content="Save" Classes="dialog" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
