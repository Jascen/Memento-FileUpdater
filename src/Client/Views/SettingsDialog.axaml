<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileUpdaterClient.UserSettings"
        xmlns:config="using:FileUpdaterClient.Config"
        x:Class="FileUpdaterClient.Views.SettingsDialog" x:DataType="vm:Preferences"
        Title="Settings" Width="440" SizeToContent="Height" CanResize="False"
        SystemDecorations="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="Transparent" TransparencyLevelHint="Transparent">
    <Window.Resources>
        <!-- Gold check boxes instead of the theme's blue -->
        <Color x:Key="SystemAccentColor">#B8862F</Color>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#B8862F" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#D9A953" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#9C6B2A" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#B8862F" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#D9A953" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#1A1512" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#1A1512" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#E8DCC0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>

    <Border Background="#F01A1512" BorderBrush="{StaticResource GoldBrush}" BorderThickness="3" CornerRadius="6"
            Padding="24,20">
        <StackPanel Spacing="14">
            <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                       Foreground="#F3D58A" />

            <StackPanel Spacing="6">
                <TextBlock Text="Install Directory" FontSize="14" FontWeight="SemiBold" Foreground="#E8DCC0" />
                <Grid ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Background="#0F0C0A" BorderBrush="#5A4630" BorderThickness="1"
                            CornerRadius="3" Padding="8,6" Margin="0,0,8,0">
                        <TextBlock Name="InstallPathText" FontSize="12" Foreground="#CDBB92"
                                   TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="1" Name="ChangeFolderButton" Classes="dialog secondary" MinWidth="0"
                            Padding="14,6" FontSize="13" Click="ChangeFolder_Click" />
                </Grid>
                <TextBlock Name="FolderErrorText" FontSize="12" Foreground="#FF6B5E" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Ignored Files" FontSize="14" FontWeight="SemiBold" Foreground="#E8DCC0" />
                <TextBlock FontSize="12" Foreground="#CDBB92" TextWrapping="Wrap"
                           Text="Files and folders never to download, one per line, written like a .gitignore. For example map0.mul, Music/ or *.cfg" />
                <TextBox Name="IgnoreText" AcceptsReturn="True" TextWrapping="NoWrap" Height="96" FontSize="12"
                         FontFamily="Consolas,Menlo,monospace" Background="#0F0C0A" Foreground="#E8DCC0"
                         BorderBrush="#5A4630" Watermark="# Nothing ignored" />
            </StackPanel>

            <CheckBox Content="Attempt to verify files on launch" IsChecked="{Binding VerifyOnLaunch}" />
            <CheckBox Content="Warn when trying to play if verification fails" IsChecked="{Binding WarnIfNotVerified}"
                      IsVisible="{x:Static config:TazUOLauncherConfig.Enabled}" />
            <CheckBox Content="Allow insecure downloads" IsChecked="{Binding AllowInsecureDownloads}"
                      ToolTip.Tip="Lets the launcher download from an update server that doesn't use https" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Content="Cancel" Classes="dialog secondary" Click="Cancel_Click" IsCancel="True" />
                <Button Content="Save" Classes="dialog" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
