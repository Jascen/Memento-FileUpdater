<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileUpdaterClient.UserSettings"
        xmlns:config="using:FileUpdaterClient.Config"
        x:Class="FileUpdaterClient.Views.SettingsDialog" x:DataType="vm:Preferences"
        Title="{x:Static config:Strings.SettingsTitle}" Width="440" SizeToContent="Height" CanResize="False"
        SystemDecorations="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="Transparent" TransparencyLevelHint="Transparent">
    <Window.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.DialogText}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource Theme.DialogBackground}" BorderBrush="{DynamicResource Theme.Frame}" BorderThickness="3" CornerRadius="6"
            Padding="24,20">
        <StackPanel Spacing="14">
            <TextBlock Text="{x:Static config:Strings.SettingsTitle}" FontFamily="{DynamicResource Theme.DisplayFont}" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource Theme.DialogTitleText}" />

            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static config:Strings.InstallFolderLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.DialogText}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Background="{DynamicResource Theme.InputBackground}" BorderBrush="{DynamicResource Theme.InputBorder}" BorderThickness="1"
                            CornerRadius="3" Padding="8,6" Margin="0,0,8,0">
                        <TextBlock Name="InstallPathText" FontSize="12" Foreground="{DynamicResource Theme.InputText}"
                                   TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="1" Name="ChangeFolderButton" Classes="dialog secondary" MinWidth="0"
                            Padding="14,6" FontSize="13" Click="ChangeFolder_Click" />
                </Grid>
                <TextBlock Name="FolderErrorText" FontSize="12" Foreground="{DynamicResource Theme.ErrorText}" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>

            <CheckBox Content="{x:Static config:Strings.VerifyOnLaunchOption}" IsChecked="{Binding VerifyOnLaunch}" />
            <CheckBox Content="{x:Static config:Strings.WarnIfNotVerifiedOption}" IsChecked="{Binding WarnIfNotVerified}"
                      IsVisible="{x:Static config:TazUOLauncherConfig.Enabled}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Content="{x:Static config:Strings.CancelText}" Classes="dialog secondary" Click="Cancel_Click" IsCancel="True" />
                <Button Content="{x:Static config:Strings.SaveText}" Classes="dialog" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
