<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="675"
        Width="900" Height="675" CanResize="False"
        SystemDecorations="None" WindowStartupLocation="CenterScreen"
        xmlns:vm="using:FileUpdaterClient.ViewModels"
        xmlns:config="using:FileUpdaterClient.Config" Background="{DynamicResource Theme.WindowBackground}" Icon="/Theme/icon.ico"
        x:Class="FileUpdaterClient.Views.MainWindow" x:DataType="vm:MainViewModel"
        PointerPressed="Window_PointerPressed">

    <Window.Styles>
        <!-- Top navigation links: brighten and grow a silver underline from the center on hover -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.NavText}" />
            <Setter Property="FontFamily" Value="{DynamicResource Theme.DisplayFont}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.NavFontSize}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Background="{TemplateBinding Background}" Margin="{TemplateBinding Padding}" Spacing="4">
                        <ContentPresenter Name="Label" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                        <Border Name="Underline" Height="2" CornerRadius="1" Background="{DynamicResource Theme.Frame}"
                                RenderTransform="scaleX(0)">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Theme.NavTextHover}" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ Border#Underline">
            <Setter Property="RenderTransform" Value="scaleX(1)" />
        </Style>

        <!-- Play button: the PlayButtonImage (270x96) that glows and grows slightly on hover.
             The glow is the image's shape filled with PlayGlow and blurred, so it follows any art -->
        <Style Selector="Button.play">
            <Setter Property="Foreground" Value="{DynamicResource Theme.PlayText}" />
            <Setter Property="FontFamily" Value="{DynamicResource Theme.DisplayFont}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.PlayFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="270" Height="96">
                        <Border Name="Glow" Margin="-10" Opacity="0.18" Background="{DynamicResource Theme.PlayGlow}"
                                OpacityMask="{DynamicResource Theme.PlayButtonMask}">
                            <Border.Effect>
                                <BlurEffect Radius="28" />
                            </Border.Effect>
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Image Source="{DynamicResource Theme.PlayButtonImage}" Stretch="Fill" />
                        <!-- Shrinks longer labels (e.g. the download text) to fit inside the frame -->
                        <Viewbox StretchDirection="DownOnly" Margin="34,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter Name="Label" Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}" Effect="{DynamicResource Theme.PlayTextShadow}" />
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.play:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>
        <Style Selector="Button.play:pointerover /template/ Border#Glow">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.play:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>
        <Style Selector="Button.play:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- Progress bars: the fill image is stretched to the full bar width and revealed from the left as progress grows.
             ProgressTotalImage (all files) and ProgressFileImage (current file), 508x22 -->
        <Style Selector="ProgressBar.bar">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource Theme.ProgressTrack}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <Border Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                            <Image Name="Fill" Stretch="Fill" HorizontalAlignment="Left"
                                   Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ProgressBar.total /template/ Image#Fill">
            <Setter Property="Source" Value="{DynamicResource Theme.ProgressTotalImage}" />
        </Style>
        <Style Selector="ProgressBar.file /template/ Image#Fill">
            <Setter Property="Source" Value="{DynamicResource Theme.ProgressFileImage}" />
        </Style>
        <Style Selector="TextBlock.barText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.ProgressText}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Effect" Value="{DynamicResource Theme.ProgressTextShadow}" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Art -->
        <Image Source="{DynamicResource Theme.BackgroundImage}" Stretch="UniformToFill" />

        <!-- Darken the edges and the top/bottom bands so text and controls stay readable over any art -->
        <Border IsHitTestVisible="False" Background="{DynamicResource Theme.EdgeShade}" />
        <Border IsHitTestVisible="False" Background="{DynamicResource Theme.BandShade}" />
        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource Theme.WindowBorder}" BorderThickness="2" />

        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Top bar: links centered, window buttons on the right -->
            <Grid Grid.Row="0" Height="60">
                <ItemsControl ItemsSource="{Binding Links}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="config:NavLink">
                            <Button Classes="nav" Content="{Binding Label}" Click="NavLink_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0" Spacing="4">
                    <Button Classes="chrome settings" Click="Settings_Click" ToolTip.Tip="{x:Static config:Strings.SettingsTooltip}">
                        <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource Theme.ChromeGlyph}"
                              Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                    </Button>
                    <Button Classes="chrome minimize" Click="Minimize_Click" ToolTip.Tip="{x:Static config:Strings.MinimizeTooltip}">
                        <Border Width="14" Height="3" Background="{DynamicResource Theme.ChromeGlyph}" CornerRadius="1" />
                    </Button>
                    <Button Classes="chrome close" Click="Close_Click" ToolTip.Tip="{x:Static config:Strings.CloseTooltip}">
                        <Path Data="M 0,0 L 14,14 M 14,0 L 0,14" Stroke="{DynamicResource Theme.ChromeGlyph}" StrokeThickness="2.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Title and play button -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource Theme.DisplayFont}"
                           FontSize="{DynamicResource Theme.TitleFontSize}" FontWeight="Bold" LetterSpacing="4"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Theme.TitleText}" Effect="{DynamicResource Theme.TitleShadow}" />
                <TextBlock Text="{Binding Subtitle}" FontFamily="{DynamicResource Theme.DisplayFont}" FontSize="{DynamicResource Theme.SubtitleFontSize}"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Theme.SubtitleText}" Effect="{DynamicResource Theme.SubtitleShadow}" />
                <Button Classes="play" Content="{Binding MainButtonText}" IsEnabled="{Binding MainButtonEnabled}"
                        IsVisible="{Binding MainButtonVisible}"
                        HorizontalAlignment="Center" Margin="0,28,0,0" Click="MainButton_Click" />

                <!-- A newer launcher is optional: everything else keeps working while this is showing -->
                <Border IsVisible="{Binding LauncherUpdateAvailable}" HorizontalAlignment="Center" Margin="0,18,0,0"
                        Padding="14,6" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Theme.NoticeBorder}" Background="{DynamicResource Theme.NoticeBackground}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding LauncherUpdateText}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Theme.NoticeText}" />
                        <Button Classes="dialog secondary" Content="{Binding UpdateLauncherText}" Click="UpdateLauncher_Click"
                                MinWidth="0" Padding="12,2" FontSize="12" />
                        <Button Classes="chrome close" Width="22" Height="22" Click="DismissLauncherUpdate_Click"
                                ToolTip.Tip="{Binding DismissLauncherUpdateText}">
                            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{DynamicResource Theme.NoticeCloseGlyph}" StrokeThickness="1.5" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Progress: top bar = all files, bottom bar = current file -->
            <Grid Grid.Row="2" Height="170">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto,Auto" Width="520">
                        <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Theme.ErrorText}" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Effect="{DynamicResource Theme.ErrorTextShadow}"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Button Grid.Column="1" Classes="dialog secondary" Content="{Binding RetryText}" Click="Retry_Click"
                                IsVisible="{Binding RetryReady}" MinWidth="0" Padding="12,2" FontSize="12" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Classes="chrome close" Width="22" Height="22" Click="Cancel_Click"
                                IsVisible="{Binding IsUpdating}" ToolTip.Tip="{x:Static config:Strings.CancelUpdateTooltip}">
                            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{DynamicResource Theme.ChromeGlyph}" StrokeThickness="1.5" />
                        </Button>
                    </Grid>

                    <!-- ProgressFrameImage (560x60); the bars sit 26 in from the sides and 6 from the top and bottom -->
                    <Grid Width="560" Height="60">
                        <Image Source="{DynamicResource Theme.ProgressFrameImage}" Stretch="Fill" Effect="{DynamicResource Theme.ProgressFrameShadow}" />
                        <StackPanel Margin="26,6" Spacing="4">
                            <Grid>
                                <ProgressBar Classes="bar total" Value="{Binding Progress}" />
                                <TextBlock Classes="barText" Text="{Binding ProgressText}" />
                            </Grid>
                            <Grid>
                                <ProgressBar Classes="bar file" Value="{Binding FileProgress}" />
                                <TextBlock Classes="barText" Text="{Binding FileProgressText}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Dims the launcher while a dialog is open -->
        <Border Background="{DynamicResource Theme.DialogDim}" IsVisible="{Binding IsDialogOpen}" />
    </Grid>
</Window>
