<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Name of the exe players run (without .exe). Change this for your server -->
    <AssemblyName>UODiabloLauncher</AssemblyName>
    <RootNamespace>FileUpdaterClient</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Theme/icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <LangVersion>default</LangVersion>
    <DebugType>none</DebugType> <!-- The launcher package is a few files, a .pdb isn't worth shipping -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PackageManifest/PackageManifest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window and taskbar icon (ApplicationIcon above only sets the exe icon, and only on Windows). Must be a real .ico, not a renamed PNG -->
    <AvaloniaResource Include="Theme\icon.ico" />
    <!-- The launcher's look and text, built into the exe: theme.json and strings.json, plus the images and fonts theme.json names -->
    <EmbeddedResource Include="Theme\*.json" LogicalName="Theme/%(Filename)%(Extension)" />
    <AvaloniaResource Include="Theme\**" Exclude="Theme\*.json" />
  </ItemGroup>

</Project>
